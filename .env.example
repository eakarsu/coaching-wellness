NODE_ENV=production
DATABASE_URL=postgres://wellness_app:change-me@127.0.0.1:5432/coaching_wellness
DATABASE_SSL=require
OIDC_ISSUER=https://identity.example.org/
OIDC_AUDIENCE=coaching-wellness
OIDC_AUTHORIZE_URL=https://identity.example.org/oauth2/authorize
OIDC_TOKEN_URL=https://identity.example.org/oauth2/token
OIDC_CLIENT_ID=wellness-web
OIDC_CLIENT_SECRET=replace-with-a-secret-manager-reference
OIDC_REDIRECT_URI=https://wellness.example.org/api/v1/wellness/auth/callback
AUTH_PUBLIC_KEY_BASE64=base64-encoded-RS256-public-key
WEBHOOK_SIGNING_SECRET=replace-with-at-least-32-random-characters
BILLING_BASE_URL=https://billing.example.org
BILLING_BEARER_TOKEN=replace-me
VIDEO_BASE_URL=https://video.example.org
VIDEO_BEARER_TOKEN=replace-me
WEARABLE_BASE_URL=https://wearable.example.org
WEARABLE_BEARER_TOKEN=replace-me
NOTIFICATION_BASE_URL=https://notifications.example.org
NOTIFICATION_BEARER_TOKEN=replace-me
ALLOW_SCHEMA_MIGRATION=0
ENABLE_LEGACY_DEMOS=0
